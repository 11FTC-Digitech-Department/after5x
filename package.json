    "android:bundle:experts": "./scripts/android-build.sh bundle experts prod",
    "android:bundle:all": "./scripts/android-build.sh bundle customer prod && ./scripts/android-build.sh bundle experts prod",
    "android:livereload": "npm run start & sleep 5 && npx cap run android --livereload",
    "docker:cleanup": "./scripts/docker-cleanup.sh"
